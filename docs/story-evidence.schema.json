{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invite MVP story evidence",
  "type": "object",
  "required": ["version", "stories"],
  "properties": {
    "version": { "const": 1 },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "feature",
          "status",
          "implementation",
          "tests",
          "e2e",
          "evidence",
          "manualAnchor"
        ],
        "properties": {
          "id": { "pattern": "^US-[0-9]{2}$" },
          "feature": { "type": "string", "minLength": 1 },
          "status": { "enum": ["planned", "partial", "verified", "waived"] },
          "implementation": { "type": "array", "items": { "type": "string" } },
          "tests": { "type": "array", "items": { "type": "string" } },
          "e2e": { "type": ["string", "null"] },
          "evidence": { "type": "string" },
          "manualAnchor": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
