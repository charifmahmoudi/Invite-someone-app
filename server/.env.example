# The API is the only process that should know this value. Never use EXPO_PUBLIC_ here.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=invite_someone
MONGODB_MAX_POOL_SIZE=5
MONGODB_MAX_IDLE_TIME_MS=30000

# Compatibility mode for existing/internal-auth clients.
AUTH_MODE=internal
JWT_SECRET=invite-local-development-secret-change-me

# Target managed authentication mode:
# AUTH_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# No Supabase service-role key is required by the current Invite API auth verifier.

PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
