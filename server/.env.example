# The API is the only process that should know this value. Never use EXPO_PUBLIC_ here.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=invite_someone
MONGODB_MAX_POOL_SIZE=5
MONGODB_MAX_IDLE_TIME_MS=30000

# Compatibility mode used by the current mobile client until Clerk is configured.
AUTH_MODE=internal
JWT_SECRET=invite-local-development-secret-change-me

# Target authentication mode. Set AUTH_MODE=clerk and configure a Clerk instance.
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_AUDIENCE=invite-api
# CLERK_SECRET_KEY=sk_test_or_live_server_only

PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
