# The API is the only process that should know this value. Never use EXPO_PUBLIC_ here.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=invite_someone
MONGODB_MAX_POOL_SIZE=5
MONGODB_MAX_IDLE_TIME_MS=30000

# Index maintenance is explicit. Keep false for normal API operation.
# Set true only for a controlled bootstrap deployment, then return it to false.
MONGODB_ENSURE_INDEXES_ON_START=false

# Compatibility mode for existing/internal-auth clients.
AUTH_MODE=internal
JWT_SECRET=invite-local-development-secret-change-me

# Target managed authentication mode:
# AUTH_MODE=firebase
# FIREBASE_PROJECT_ID=invite-someone-app
# The API verifies Firebase ID tokens against Google's public signing certificates.
# No Firebase service-account JSON/private key is required by this verifier.

PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
