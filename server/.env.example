# The API is the only process that should know this value. Never use EXPO_PUBLIC_ here.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=invite_someone

# Replace before exposing the API. Production startup refuses this development value.
JWT_SECRET=invite-local-development-secret-change-me
PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# City-only geocoding is proxied and cached by the API; mobile builds never call it directly.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/
GEOCODING_USER_AGENT=InviteSomeone/1.0 (+https://github.com/charifmahmoudi/Invite-someone-app)
