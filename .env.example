# Preferred production path: the public HTTPS address of the Invite API.
# The MongoDB URI belongs in .env.server and must never use an EXPO_PUBLIC_ name.
# EXPO_PUBLIC_API_URL=https://api.invite.example

# Optional managed authentication. When present, the Expo app uses Clerk email OTP
# and Google instead of Invite's compatibility email/password UI.
# This publishable key is safe for the client; never expose CLERK_SECRET_KEY here.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key

# Optional legacy Supabase path. MongoDB API configuration takes precedence.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key