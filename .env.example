# Preferred production path: the public HTTPS address of the Invite API.
# The MongoDB URI belongs in .env.server and must never use an EXPO_PUBLIC_ name.
# EXPO_PUBLIC_API_URL=https://api.invite.example

# Managed authentication: Supabase Auth proves identity while the Invite API and
# MongoDB remain authoritative for profiles, activities, invitations, and authorization.
# Both values below are public client configuration and are safe to embed in the app.
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only configuration for the Invite API when AUTH_MODE=supabase:
# AUTH_MODE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB_NAME=invite_someone

# Internal password/JWT authentication remains available temporarily for compatibility
# with older builds. Do not add Supabase service-role or secret keys to the Expo app.
