# Preferred production path: the public HTTPS address of the Invite API.
# The MongoDB URI belongs in .env.server and must never use an EXPO_PUBLIC_ name.
# EXPO_PUBLIC_API_URL=https://api.invite.example

# Firebase Auth public Web client configuration. These values identify the Firebase app;
# they are not service-account credentials and are expected to ship in the client.
# EXPO_PUBLIC_FIREBASE_API_KEY=your_web_api_key
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
# EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:example

# Android Google sign-in is configured natively through google-services.json plus the
# Google OAuth Android client registered for the package/signing certificate. No OAuth
# client secret and no EXPO_PUBLIC_GOOGLE_* variables are required for the Android flow.

# Server-only mode selection. Firebase ID-token verification needs only the project ID.
# AUTH_MODE=firebase
# FIREBASE_PROJECT_ID=your-project
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB_NAME=invite_someone
# MONGODB_ENSURE_INDEXES_ON_START=false
# Keep the index bootstrap flag false in normal operation. Set true only for a controlled
# environment bootstrap, confirm the expected indexes, then return it to false.

# Internal password/JWT authentication remains available temporarily for compatibility
# with older builds. Never place MongoDB credentials, OAuth client secrets, Firebase
# service-account JSON, or private keys in EXPO_PUBLIC_* variables.
